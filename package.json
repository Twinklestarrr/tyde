{
  "name": "tyde",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "check:staged": "node scripts/check-commit-policy.mjs staged && lint-staged --hide-unstaged",
    "check:message": "node scripts/check-commit-policy.mjs commit-msg",
    "setup:local": "node scripts/setup-local.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "test:e2e": "playwright test",
    "test:frontend": "pnpm build:web && pnpm --filter @tyde/electron build && playwright test --config playwright.frontend.config.ts",
    "test:packaged": "playwright test --config playwright.packaged.config.ts",
    "db:local:start": "node scripts/postgres-local.mjs start",
    "db:local:stop": "node scripts/postgres-local.mjs stop",
    "db:local:status": "node scripts/postgres-local.mjs status",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:server": "npm --prefix apps/server run dev",
    "dev:agent": "pnpm --filter @tyde/agent dev",
    "dev:agent-web": "pnpm --filter @tyde/agent-web dev",
    "dev:electron": "node scripts/dev-electron.mjs",
    "dev:electron:test": "node --env-file=apps/electron/config/test.env scripts/dev-electron.mjs",
    "dev:electron:inspect": "node scripts/dev-electron.mjs --inspect",
    "dev:electron:test:inspect": "node --env-file=apps/electron/config/test.env scripts/dev-electron.mjs --inspect",
    "build:packages": "pnpm --filter @tyde/shared build && pnpm --filter @tyde/platform build",
    "build:web": "pnpm --filter @tyde/web build",
    "build:agent": "pnpm --filter @tyde/agent build",
    "build:agent-web": "pnpm --filter @tyde/agent-web build",
    "build:server": "pnpm --filter @tyde/web build --outDir ../server/public --emptyOutDir && pnpm --filter @tyde/server build",
    "build:vercel": "pnpm build:server",
    "build:electron": "pnpm build:web && pnpm --filter @tyde/electron build",
    "package:mac": "pnpm build:electron && pnpm --filter @tyde/electron package:mac",
    "package:win": "pnpm build:electron && pnpm --filter @tyde/electron package:win",
    "package:web": "pnpm build:web && node scripts/package-deploy.mjs web",
    "package:server": "pnpm build:server && node scripts/package-deploy.mjs server",
    "typecheck": "pnpm build:packages && pnpm --filter @tyde/server db:generate && pnpm -r --if-present typecheck",
    "typecheck:agent": "pnpm --filter @tyde/shared build && pnpm --filter @tyde/agent typecheck && pnpm --filter @tyde/agent-web typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @tyde/server test",
    "test:agent": "pnpm check:agent-contracts && pnpm --filter @tyde/agent test && pnpm --filter @tyde/agent-web test",
    "generate:agent-contracts": "node scripts/generate-agent-contracts.mjs",
    "check:agent-contracts": "node scripts/generate-agent-contracts.mjs --check",
    "test:integration": "pnpm --filter @tyde/server test:integration",
    "test:core": "pnpm --filter @tyde/shared build && tsx --test tests/*.test.mjs",
    "db:generate": "pnpm --filter @tyde/server db:generate",
    "db:migrate": "pnpm --filter @tyde/server db:migrate",
    "db:deploy": "pnpm --filter @tyde/server db:deploy",
    "db:cleanup": "pnpm --filter @tyde/server db:cleanup",
    "db:deploy:test": "node scripts/migrate-test.mjs"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx}": "eslint --max-warnings 0 --no-warn-ignored",
    "*": "prettier --check --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.6",
    "ajv": "8.20.0",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
