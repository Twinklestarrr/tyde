{
  "name": "@tyde/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../../packages/shared run build && npm --prefix ../../packages/platform run build",
    "dev": "vite --port 3001 --strictPort",
    "build": "pnpm --filter @tyde/shared build && pnpm --filter @tyde/platform build && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdxeditor/editor": "4.2.5",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-router": "1.161.3",
    "@tyde/platform": "workspace:*",
    "@tyde/shared": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.85.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0",
    "vite": "7.3.6"
  }
}
