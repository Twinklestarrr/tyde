{
  "name": "@tyde/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "predev": "pnpm --filter @tyde/shared build",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "pnpm --filter @tyde/shared build && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:maas": "node --env-file-if-exists=.env --import tsx src/cli/smoke.ts",
    "smoke:model": "node --env-file-if-exists=.env --import tsx src/cli/model-smoke.ts",
    "test": "pnpm --filter @tyde/shared build && node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "5.2.6",
    "@tyde/shared": "workspace:*",
    "canonicalize": "5.1.0",
    "fastify": "5.6.2",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
