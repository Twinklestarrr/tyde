{
  "name": "@tyde/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "predev": "pnpm --filter @tyde/shared build",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "pnpm --filter @tyde/shared build && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @tyde/shared build && node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "5.2.6",
    "@tyde/shared": "workspace:*",
    "canonicalize": "5.1.0",
    "fastify": "5.6.2"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
