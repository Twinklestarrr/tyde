NODE_ENV=development
AGENT_HOST=127.0.0.1
AGENT_PORT=3002

# 正式持久模式默认 postgres；缺少连接或版本不兼容时拒绝启动，不回退内存。
AGENT_STORAGE_MODE=postgres
# 独立 Agent 数据库，固定 agent schema；运行账号与迁移账号分开。
# AGENT_DATABASE_URL=postgresql://agent_runtime@127.0.0.1:55435/agent_database
# AGENT_MIGRATION_DATABASE_URL=postgresql://agent_migrator@127.0.0.1:55435/agent_database
# AGENT_PUBLISH_DATABASE_URL=postgresql://agent_publisher@127.0.0.1:55435/agent_database
# 仅开发时可显式改为 memory；重启清空历史和命令裁决。

# 默认不接受任何资源身份，健康检查仍可匿名访问。
AGENT_AUTH_MODE=disabled
# 仅内部开发/测试可显式改为 development，并仅监听 127.0.0.1 或 ::1。
# 服务端固定用户；不要把凭证提交到 Git 或放进 Agent Web 的 VITE_* 配置。
# AGENT_TEST_USER_ID=local-agent-developer
# AGENT_TEST_BEARER_TOKEN=使用本机随机生成的至少32字符凭证

# W2 本地模型验收：在忽略的 .env 中填 URL 与 Key，运行 smoke:model。
# 默认官方 DeepSeek，模型自动使用 deepseek-flash 并关闭思考；其他兼容地址另填 MODEL_ID。
# Key 仅供服务端读取，不要写入源码、前端 VITE_* 变量或安装包。
AGENT_MODEL_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL_API_KEY=
# 仅官方 DeepSeek 地址可兼容此别名；自定义地址必须显式设置 AGENT_MODEL_API_KEY。
# DEEPSEEK_API_KEY=
# AGENT_MODEL_ID=
# 可选本地预算；默认输出 1024；上下文默认官方 DeepSeek 1048576、其他地址 32768。
# 这些是客户端预算，不代表自定义模型的已验证容量。
# AGENT_MODEL_CONTEXT_WINDOW=
# AGENT_MODEL_MAX_TOKENS=
# 可选超时毫秒，默认分别为 3000、15000、60000、45000、180000。
# AGENT_MODEL_CONNECT_TIMEOUT_MS=
# AGENT_MODEL_HEADERS_TIMEOUT_MS=
# AGENT_MODEL_FIRST_PROGRESS_TIMEOUT_MS=
# AGENT_MODEL_IDLE_TIMEOUT_MS=
# AGENT_MODEL_TOTAL_TIMEOUT_MS=

# 可选：24 号平台转发验收，单独运行 smoke:maas，主模型入口不要求这些配置。
# 仅填写平台核实后的实际配置，不使用模型、路由或凭据示例值。
# BASE_URL 必须以 /internal/agent-maas/v1 结尾，Pi 追加 /chat/completions。
# AGENT_MAAS_BASE_URL=
# AGENT_MAAS_MODEL_ID=
# 实际响应 model 的允许值，填写非空、不重复的 JSON 字符串数组。
# AGENT_MAAS_ACTUAL_MODEL_IDS=
# AGENT_MAAS_ROUTE_VERSION=
# 平台服务 Bearer 凭据，不是上游供应商 Key。
# AGENT_MAAS_SERVICE_TOKEN=
# AGENT_MAAS_CONTEXT_WINDOW=
# AGENT_MAAS_MAX_TOKENS=
# 由平台逐路由验收后提供完整 compat JSON，字段及取值见 README。
# AGENT_MAAS_COMPAT=
# 显式服务端 JS 模块的绝对路径；导出 resolveIdentity 并验证平台授权及撤销。
# 不得用 AGENT_TEST_USER_ID 或客户端自报 subject 代替可信主体来源。
# AGENT_MAAS_IDENTITY_MODULE=
# 可选超时，单位毫秒；未配置时分别为 3000、15000、60000、45000、180000。
# AGENT_MAAS_CONNECT_TIMEOUT_MS=
# AGENT_MAAS_HEADERS_TIMEOUT_MS=
# AGENT_MAAS_FIRST_PROGRESS_TIMEOUT_MS=
# AGENT_MAAS_IDLE_TIMEOUT_MS=
# AGENT_MAAS_TOTAL_TIMEOUT_MS=
