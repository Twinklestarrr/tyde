# 复制为 .env 文件，并在本地填写模型密钥。
LLM_PROVIDER=deepseek
LLM_MODEL_NAME=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT=60
JUDGE_MODEL_NAME=deepseek-chat

API_HOST=127.0.0.1
API_PORT=29321

# 页面加载等待独立于系统键鼠操作超时，可按网络情况调整。
# PAGE_LOAD_TIMEOUT=30

# 以下绝对路径配置可选，默认使用项目根目录下的数据目录。
# HISTORY_SAVE_PATH=/absolute/path/to/sessions
# TOKEN_FILE_PATH=/absolute/path/to/agent_token.txt
# PID_FILE_PATH=/absolute/path/to/agent.pid
