// 仅保存实际项目成员真值；注册/组织身份/管理授权不会创建成员。
model ProjectMember {
  id                          Int                      @id @default(autoincrement())
  projectId                   Int
  userId                      String                   @db.Uuid
  userOrgRelId                String?                  @db.Uuid
  organizationId              String?                  @db.Uuid
  // 接单来源外键已在第14迁移接入；准入来源待08，无来源写入口或伪造记录。
  expertAssignmentId          Int?
  admissionAttemptId          Int?                     @unique
  admittedAt                  DateTime?                @db.Timestamptz(3)
  entryDecision               String?                  @db.VarChar(12)
  plannedEntryDate            DateTime?                @db.Date
  entryDeclineReason          String?                  @db.VarChar(500)
  projectRole                 String                   @default("MEMBER") @db.VarChar(20)
  status                      String                   @default("ACTIVE") @db.VarChar(24)
  joinedAt                    DateTime?                @db.Timestamptz(3)
  standardTrainingConfirmedAt DateTime?                @db.Timestamptz(3)
  plannedLeaveDate            DateTime?                @db.Date
  leftAt                      DateTime?                @db.Timestamptz(3)
  createdBy                   String                   @db.VarChar(36)
  updatedBy                   String?                  @db.VarChar(36)
  createdAt                   DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                 @updatedAt @db.Timestamptz(3)
  project                     Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user                        User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  organizationMembership      UserOrgRel?              @relation(fields: [userOrgRelId], references: [id], onDelete: Restrict)
  organization                Organization?            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  expertAssignment            ProjectExpertAssignment? @relation(fields: [expertAssignmentId], references: [id], onDelete: Restrict)
  admissionAttempt            EntranceExamAttempt?     @relation(fields: [admissionAttemptId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([userOrgRelId, status])
  @@index([projectId, status, joinedAt])
  @@index([projectId, status, plannedEntryDate, plannedLeaveDate])
  @@index([projectId, organizationId, status])
}

model ProjectRoleNodeSnapshot {
  id             Int      @id @default(autoincrement())
  projectId      Int
  userId         String   @db.Uuid
  perspective    String   @db.VarChar(32)
  branchNodeCode String   @db.VarChar(64)
  branchPriority Int
  sourceBizType  String   @db.VarChar(32)
  sourceBizId    Int
  sourceEventAt  DateTime @db.Timestamptz(3)
  calculatedAt   DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId, perspective])
  @@index([userId, perspective])
  @@index([calculatedAt])
}

// 04列表读取前置；接单写流程及容量/组织校验归07，不能由本表存在推导业务已迁移。
model ProjectExpertAssignment {
  id                    Int                             @id @default(autoincrement())
  assignmentNo          String                          @unique @db.VarChar(64)
  projectId             Int
  subjectType           String                          @db.VarChar(24)
  organizationId        String?                         @db.Uuid
  expertUserId          String?                         @db.Uuid
  projectOwnerUserId    String?                         @db.Uuid
  previousAssignmentId  Int?
  productionRequirement Decimal?                        @db.Decimal(20, 4)
  operatorHeadcount     Int?
  inspectorHeadcount    Int?
  status                String                          @default("PENDING_ACCEPTANCE") @db.VarChar(24)
  acceptedAt            DateTime?                       @db.Timestamptz(3)
  rejectedAt            DateTime?                       @db.Timestamptz(3)
  rejectReason          String?
  createdBy             String                          @db.VarChar(36)
  updatedBy             String?                         @db.VarChar(36)
  createdAt             DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                        @updatedAt @db.Timestamptz(3)
  project               Project                         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  organization          Organization?                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  expert                User?                           @relation("AssignedExpert", fields: [expertUserId], references: [id], onDelete: Restrict)
  legacyOwner           User?                           @relation("LegacyAssignmentOwner", fields: [projectOwnerUserId], references: [id], onDelete: Restrict)
  owners                ProjectExpertAssignmentOwner[]
  members               ProjectMember[]
  previousAssignment    ProjectExpertAssignment?        @relation("PreviousAssignment", fields: [previousAssignmentId], references: [id], onDelete: Restrict)
  replacements          ProjectExpertAssignment[]       @relation("PreviousAssignment")
  memberResponses       ProjectExpertAssignmentMember[]

  @@index([projectId, status])
}

model ProjectExpertAssignmentOwner {
  id           Int                     @id @default(autoincrement())
  assignmentId Int
  userId       String                  @db.Uuid
  status       String                  @default("ACTIVE") @db.VarChar(16)
  appointedAt  DateTime                @default(now()) @db.Timestamptz(3)
  removedAt    DateTime?               @db.Timestamptz(3)
  createdBy    String                  @db.VarChar(36)
  updatedBy    String?                 @db.VarChar(36)
  createdAt    DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(3)
  assignment   ProjectExpertAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, userId])
  @@index([userId, status])
}

// 仅04列表协助阅卷来源读取；05落地配置版本后补版本外键及全部考试写流程。
model ProjectEntranceExam {
  id               Int                   @id @default(autoincrement())
  examNo           String                @unique @db.VarChar(64)
  projectId        Int
  examName         String                @db.VarChar(128)
  status           String                @default("ACTIVE") @db.VarChar(16)
  currentVersionId Int?
  closedBy         String?               @db.VarChar(36)
  closedAt         DateTime?             @db.Timestamptz(3)
  closeReason      String?               @db.VarChar(500)
  createdBy        String                @db.VarChar(36)
  updatedBy        String?               @db.VarChar(36)
  deleted          Boolean               @default(false)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  attempts         EntranceExamAttempt[]
  versions         EntranceExamVersion[] @relation("ExamVersions")
  currentVersion   EntranceExamVersion?  @relation("ExamCurrentVersion", fields: [currentVersionId, id], references: [id, examId], onDelete: Restrict)

  @@index([projectId, status, deleted, createdAt])
