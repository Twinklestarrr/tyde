  planId             Int
  plan               ProjectProductionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  sequenceNo         Int
  crowdName          String                @db.VarChar(100)
  profileRequirement String
  createdBy          String
  updatedBy          String?
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)

  @@unique([planId, sequenceNo])
}

model ProjectProductionStage {
  id                 Int                   @id @default(autoincrement())
  planId             Int
  plan               ProjectProductionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  sequenceNo         Int
  stageName          String                @db.VarChar(100)
  startDate          DateTime              @db.Date
  endDate            DateTime              @db.Date
