model EntranceExamGradingRound {
  id             Int      @id @default(autoincrement())
  examVersionId  Int
  roundNo        Int
  gradingMode    String   @db.VarChar(16)
  toolCode       String?  @db.VarChar(64)
  toolName       String?  @db.VarChar(128)
  toolConfigJson Json?
  reviewersJson  Json?
  createdBy      String   @db.VarChar(36)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  version EntranceExamVersion         @relation(fields: [examVersionId], references: [id], onDelete: Restrict)
  records EntranceExamGradingRecord[]

  @@unique([examVersionId, roundNo])
  @@unique([id, examVersionId])
}

// scopeKey=PERSONAL或orgId；避免PostgreSQL可空唯一键导致个人作用域重复。
model OrgMemberSchedule {
  id           Int                  @id @default(autoincrement())
  scopeKey     String               @db.VarChar(36)
  orgId        String?              @db.Uuid
  userOrgRelId String?              @db.Uuid
  userId       String               @db.Uuid
  scheduleDate DateTime             @db.Date
  dayType      String               @db.VarChar(8)
  shiftStartAt DateTime?            @db.Timestamp(3)
  shiftEndAt   DateTime?            @db.Timestamp(3)
  timezone     String               @default("Asia/Shanghai") @db.VarChar(64)
  sourceType   String               @default("MANUAL") @db.VarChar(16)
  batchNo      String?              @db.VarChar(64)
  status       String               @default("ACTIVE") @db.VarChar(16)
  versionNo    Int                  @default(0)
  createdBy    String               @db.VarChar(36)
  updatedBy    String               @db.VarChar(36)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization?        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  membership   UserOrgRel?          @relation(fields: [userOrgRelId, userId, orgId], references: [id, userId, orgId], onDelete: Restrict)
  days         OrgAttendanceDaily[]

  @@unique([scopeKey, userId, scheduleDate])
  @@index([orgId, scheduleDate])
}

model OrgAttendanceDaily {
  id                Int                       @id @default(autoincrement())
  scopeKey          String                    @db.VarChar(36)
  orgId             String?                   @db.Uuid
  userOrgRelId      String?                   @db.Uuid
  userId            String                    @db.Uuid
  attendanceDate    DateTime                  @db.Date
  scheduleId        Int?
  expectedStartAt   DateTime?                 @db.Timestamp(3)
  expectedEndAt     DateTime?                 @db.Timestamp(3)
  firstClockInAt    DateTime?                 @db.Timestamp(3)
  lastClockOutAt    DateTime?                 @db.Timestamp(3)
  autoStatus        String?                   @db.VarChar(24)
  finalStatus       String?                   @db.VarChar(24)
  lateMinutes       Int                       @default(0)
  earlyLeaveMinutes Int                       @default(0)
  workedMinutes     Int                       @default(0)
  reviewRequired    Boolean                   @default(false)
  reviewReason      String?                   @db.VarChar(1000)
  manualOverride    Boolean                   @default(false)
  manualRemark      String?                   @db.VarChar(1000)
  correctedBy       String?                   @db.VarChar(36)
  correctedAt       DateTime?                 @db.Timestamptz(3)
  calculatedAt      DateTime?                 @db.Timestamptz(3)
  versionNo         Int                       @default(0)
  createdBy         String                    @db.VarChar(36)
  updatedBy         String                    @db.VarChar(36)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(3)
  user              User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization      Organization?             @relation(fields: [orgId], references: [id], onDelete: Restrict)
  membership        UserOrgRel?               @relation(fields: [userOrgRelId, userId, orgId], references: [id, userId, orgId], onDelete: Restrict)
  schedule          OrgMemberSchedule?        @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  adjustments       OrgAttendanceAdjustment[]

  @@unique([scopeKey, userId, attendanceDate])
  @@index([orgId, attendanceDate])
}

model OrgAttendanceAdjustment {
  id                Int                @id @default(autoincrement())
  attendanceDailyId Int
  beforeStatus      String?            @db.VarChar(24)
  afterStatus       String             @db.VarChar(24)
  beforeRemark      String?            @db.VarChar(1000)
  afterRemark       String?            @db.VarChar(1000)
  reason            String             @db.VarChar(1000)
  operatorUserId    String             @db.Uuid
  operatorName      String             @db.VarChar(200)
  createdBy         String             @db.VarChar(36)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  daily             OrgAttendanceDaily @relation(fields: [attendanceDailyId], references: [id], onDelete: Restrict)
  operator          User               @relation(fields: [operatorUserId], references: [id], onDelete: Restrict)

  @@index([attendanceDailyId, createdAt])
}

model PersonalScheduleReceipt {
  id          Int      @id @default(autoincrement())
  userId      String   @db.Uuid
  key         String   @db.VarChar(128)
  requestHash String   @db.VarChar(64)
  response    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, key])
}

// 本人项目查询前置。接单写流程由07接入，不由读取接口伪造响应记录。
model ProjectExpertAssignmentMember {
  id           Int                     @id @default(autoincrement())
  assignmentId Int
  userId       String                  @db.Uuid
  userOrgRelId String                  @db.Uuid
  status       String                  @db.VarChar(16)
  rejectReason String?                 @db.VarChar(500)
  respondedAt  DateTime?               @db.Timestamptz(3)
  createdBy    String                  @db.VarChar(36)
  updatedBy    String?                 @db.VarChar(36)
  createdAt    DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(3)
  assignment   ProjectExpertAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership   UserOrgRel              @relation(fields: [userOrgRelId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, userId])
  @@index([userId, status])
}

// 应试事实复用；05已准备配置版本/试卷外键，第17迁移待应用；08接考试写入口。
model EntranceExamAttempt {
  id                 Int                  @id @default(autoincrement())
  attemptNo          String               @unique @db.VarChar(64)
  examId             Int
  examVersionId      Int?
  paperId            Int?
  candidateUserId    String               @db.Uuid
  candidateUid       String               @db.VarChar(36)
  candidateName      String               @db.VarChar(200)
  userOrgRelId       String?              @db.Uuid
  organizationId     String?              @db.Uuid
  organizationName   String?              @db.VarChar(128)
  sourceBizType      String               @default("EXPERT_ORDER") @db.VarChar(64)
  sourceBizId        Int?
  gradingStatus      String               @default("NOT_STARTED") @db.VarChar(24)
  finalResult        String               @default("PENDING") @db.VarChar(16)
  enteredAt          DateTime?            @db.Timestamptz(3)
  answerDeadlineAt   DateTime?            @db.Timestamptz(3)
  integritySignedAt  DateTime?            @db.Timestamptz(3)
  submittedAt        DateTime?            @db.Timestamptz(3)
  cancelledAt        DateTime?            @db.Timestamptz(3)
  finalDecidedAt     DateTime?            @db.Timestamptz(3)
  decisionDetailJson Json?
  createdBy          String               @db.VarChar(36)
  updatedBy          String?              @db.VarChar(36)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  exam               ProjectEntranceExam  @relation(fields: [examId], references: [id], onDelete: Restrict)
  candidate          User                 @relation(fields: [candidateUserId], references: [id], onDelete: Restrict)
  organization       Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership         UserOrgRel?          @relation(fields: [userOrgRelId], references: [id], onDelete: Restrict)
  admittedMember     ProjectMember?
  version            EntranceExamVersion? @relation(fields: [examVersionId, examId], references: [id, examId], onDelete: Restrict)
  paper              EntranceExamPaper?   @relation(fields: [paperId, examVersionId], references: [id, examVersionId], onDelete: Restrict)

  gradingRecords EntranceExamGradingRecord[]
  answers        EntranceExamAnswer[]

  @@unique([id, paperId])
  @@unique([id, examVersionId])
  @@index([candidateUserId, examId])
}

// 配置以版本保存，发布/编辑新增版本而非覆盖历史。
model EntranceExamVersion {
  id                   Int                        @id @default(autoincrement())
  examId               Int
  versionNo            Int
  examNameSnapshot     String                     @db.VarChar(128)
  durationMinutes      Int?
  registrationDeadline DateTime                   @db.Timestamptz(3)
  fullScore            Decimal                    @db.Decimal(10, 2)
  passScore            Decimal                    @db.Decimal(10, 2)
  decisionRule         String                     @default("MAJORITY") @db.VarChar(24)
  tieBreakRule         String?                    @db.VarChar(16)
  publishedBy          String                     @db.VarChar(36)
  publishedAt          DateTime                   @db.Timestamptz(3)
  createdBy            String                     @db.VarChar(36)
  createdAt            DateTime                   @default(now()) @db.Timestamptz(3)
  exam                 ProjectEntranceExam        @relation("ExamVersions", fields: [examId], references: [id], onDelete: Restrict)
  currentFor           ProjectEntranceExam[]      @relation("ExamCurrentVersion")
  papers               EntranceExamPaper[]
  gradingRounds        EntranceExamGradingRound[]
  attempts             EntranceExamAttempt[]

  @@unique([examId, versionNo])
  @@unique([id, examId])
  @@index([examId, publishedAt])
}

model EntranceExamPaper {
  id            Int                    @id @default(autoincrement())
  examVersionId Int
  sequenceNo    Int
  paperName     String?                @db.VarChar(100)
  totalScore    Decimal                @db.Decimal(10, 2)
  createdBy     String                 @db.VarChar(36)
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)
  version       EntranceExamVersion    @relation(fields: [examVersionId], references: [id], onDelete: Restrict)
  questions     EntranceExamQuestion[]
  attempts      EntranceExamAttempt[]

  @@unique([examVersionId, sequenceNo])
  @@unique([id, examVersionId])
}

model EntranceExamQuestion {
  id                 Int               @id @default(autoincrement())
  paperId            Int
  sequenceNo         Int
  questionContent    String?           @db.Text
  questionFilesJson  Json?
  requiredFlag       Boolean           @default(true)
  score              Decimal           @db.Decimal(10, 2)
  scoreSource        String            @default("AUTO") @db.VarChar(16)
  referenceAnswer    String?           @db.Text
  referenceFilesJson Json?
  createdBy          String            @db.VarChar(36)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  paper              EntranceExamPaper @relation(fields: [paperId], references: [id], onDelete: Restrict)

  answers EntranceExamAnswer[]

  @@unique([id, paperId])
  @@unique([paperId, sequenceNo])
}

// 逐轮执行/汇总结果，记录只绑定考生进入时的同版本轮次；写入/派发流程后续接入。
model EntranceExamGradingRecord {
  id                Int                      @id @default(autoincrement())
  attemptId         Int
  gradingRoundId    Int
  examVersionId     Int
  status            String                   @default("PENDING") @db.VarChar(16)
  reviewerUserId    String?                  @db.Uuid
  toolTraceId       String?                  @db.VarChar(128)
  callbackDigest    String?                  @db.VarChar(64)
  score             Decimal?                 @db.Decimal(10, 2)
  roundResult       String?                  @db.VarChar(16)
  conclusionSummary String?                  @db.Text
  errorMessage      String?                  @db.VarChar(1000)
  startedAt         DateTime?                @db.Timestamptz(3)
  completedAt       DateTime?                @db.Timestamptz(3)
  createdBy         String                   @db.VarChar(36)
  updatedBy         String?                  @db.VarChar(36)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)
  attempt           EntranceExamAttempt      @relation(fields: [attemptId, examVersionId], references: [id, examVersionId], onDelete: Restrict)
  gradingRound      EntranceExamGradingRound @relation(fields: [gradingRoundId, examVersionId], references: [id, examVersionId], onDelete: Restrict)
  reviewer          User?                    @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  items EntranceExamGradingItem[]

  @@unique([id, attemptId])
  @@unique([attemptId, gradingRoundId])
  @@index([reviewerUserId, status, createdAt])
  @@index([gradingRoundId, status, createdAt])
  @@index([status, attemptId])
}

// 逐题答案绑定应试试卷；本批只建来源结构及只读接口，交卷写入口归08。
model EntranceExamAnswer {
  id              Int                       @id @default(autoincrement())
  attemptId       Int
  paperId         Int
  questionId      Int
  answerContent   String?                   @db.Text
  answerFilesJson Json?
  answeredFlag    Boolean                   @default(false)
  createdBy       String                    @db.VarChar(36)
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)
  attempt         EntranceExamAttempt       @relation(fields: [attemptId, paperId], references: [id, paperId], onDelete: Restrict)
  question        EntranceExamQuestion      @relation(fields: [questionId, paperId], references: [id, paperId], onDelete: Restrict)
  gradingItems    EntranceExamGradingItem[]

  @@unique([attemptId, questionId])
  @@unique([id, attemptId, questionId])
}

// answer与record须为同一应试记录，question须与answer一致；禁止跨人/跨题判卷。
model EntranceExamGradingItem {
  id              Int                       @id @default(autoincrement())
  gradingRecordId Int
  attemptId       Int
  questionId      Int
  answerId        Int
  correctness     String                    @default("PENDING") @db.VarChar(16)
  gradingOpinion  String?                   @db.Text
  createdBy       String                    @db.VarChar(36)
  updatedBy       String?                   @db.VarChar(36)
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(3)
  gradingRecord   EntranceExamGradingRecord @relation(fields: [gradingRecordId, attemptId], references: [id, attemptId], onDelete: Restrict)
  answer          EntranceExamAnswer        @relation(fields: [answerId, attemptId, questionId], references: [id, attemptId, questionId], onDelete: Restrict)

  @@unique([gradingRecordId, questionId])
  @@index([answerId, attemptId, questionId])
}

// 组织、操作者、接口类型共同隔离幂等键；回执与排班在同一事务提交。
model OrganizationScheduleReceipt {
  id           Int          @id @default(autoincrement())
  orgId        String       @db.Uuid
  userId       String       @db.Uuid
  kind         String       @db.VarChar(16)
  key          String       @db.VarChar(128)
  requestHash  String       @db.VarChar(64)
  response     Json
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([orgId, userId, kind, key])
}

// 仅持久化待投递事实；实际消费/投递由14接入。
model AttendanceEventOutbox {
  id        Int      @id @default(autoincrement())
  orgId     String?   @db.Uuid
  eventType String   @db.VarChar(32)
  payload   Json
  status    String   @default("PENDING") @db.VarChar(16)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

// 原始事件仅追加；clockAt为请求时区的墙上时间，occurredAt为服务端UTC瞬时。
model AttendanceClockEvent {
  id Int @id @default(autoincrement())
  eventNo String @unique @db.VarChar(64)
  scopeKey String @db.VarChar(36)
  orgId String? @db.Uuid
  userOrgRelId String? @db.Uuid
  userId String @db.Uuid
  attendanceDate DateTime @db.Date
  clockType String @db.VarChar(16)
  clockAt DateTime @db.Timestamp(3)
  occurredAt DateTime @db.Timestamptz(3)
  timezone String @db.VarChar(64)
  sourceType String @default("WORKBENCH_CLICK") @db.VarChar(24)
  sourceRef String? @db.VarChar(128)
  clientIp String? @db.VarChar(64)
  extJson Json?
  createdBy String @db.VarChar(36)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)
  membership UserOrgRel? @relation(fields: [userOrgRelId, userId, orgId], references: [id, userId, orgId], onDelete: Restrict)
  @@index([scopeKey, userId, attendanceDate])
}
